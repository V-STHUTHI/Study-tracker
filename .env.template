# Daymark Study Tracker deployment (required for shared accounts and sync)
# Create a Supabase project, then copy Project URL and the publishable/anon key
# from Supabase Dashboard -> Project Settings -> API.
# Apply chatkit/supabase/schema.sql in Supabase Dashboard -> SQL Editor first.
# Put these same two values in your hosting provider's environment settings.
# For Vercel, set the project Root Directory to "chatkit".
# Never put a Supabase service_role/secret key in this file or a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional legacy ChatKit starter settings (not required by the study tracker)
# Only needed if you use the original ChatKit workflow UI/API. Daymark does not need them.
# Add a real OpenAI API key and a workflow ID after publishing a workflow in Agent Builder.
# Keep the API key server-side and do not commit it to this template.
# OPENAI_API_KEY=
# NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=
CHATKIT_API_BASE=https://api.openai.com

# Optional course/notebook settings (not required to deploy the study tracker)
OPENAI_DEFAULT_MODEL=gpt-5-nano
EXA_API_KEY=your-exa-api-key

# Optional Chainlit authentication settings for the Python demos.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAINLIT_AUTH_SECRET=kala
CHAINLIT_USERNAME=kala
CHAINLIT_PASSWORD=kala