# Server-side OpenAI API key. Create it in the same project as your workflow.
# Never use a NEXT_PUBLIC_ prefix for this secret.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Published workflow ID from https://platform.openai.com/agent-builder
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=wf_replace_with_your_workflow_id

# Optional. Leave at the default for the OpenAI-hosted ChatKit API.
CHATKIT_API_BASE=https://api.openai.com
# Create a Supabase project, run supabase/schema.sql in its SQL editor, then
# copy the project URL and anon/public key from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
